; Copy to .env beside index.php or the standalone executable.
; Console preferences and encrypted credentials are saved in the external data directory.
; Deployment changes require restarting RCMAKER. Exclude your real .env from releases.
[gateway]
console_port = 28910
api_port = 28911
browser_debug_port = 28912
; Directory NAME beside the executable, created on first run. Never stored in the archive.
data_directory = data
database_name = gateway.sqlite
default_locale = en
; auto / always / never; NO_COLOR and RCMAKER_COLOR follow framework banner rules.
banner_color = auto
; Optional external Codex home; blank enables automatic detection.
codex_home = ""
; Optional CA certificate path for network probes.
probe_ca_file = ""

[app]
default_timezone = UTC
