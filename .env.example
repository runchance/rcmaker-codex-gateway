; Copy to .env beside index.php or the standalone executable.
; Console preferences and encrypted credentials are saved in the external data directory.
; Deployment changes require restarting RCMAKER. Exclude your real .env from releases.
[gateway]
console_port = 28910
api_port = 28911
browser_debug_port = 28912
; auto preserves Chrome negotiation. http1 is an opt-in workaround for verified HTTP/2 stream
; failures. It disables HTTP/2 and QUIC only in the private Chrome after a normal restart.
; It cannot repair server/proxy timeouts; compare real long tasks before adopting it.
browser_http_protocol = auto
; Maximum attachment upload/indexing wait, in seconds (60–1800). The task deadline still applies.
attachment_upload_timeout_seconds = 600
; Slow desktop startup and temporary Windows file-scanner locks; values are bounded.
browser_start_timeout_seconds = 180
browser_runtime_publish_timeout_seconds = 10
; Directory NAME beside the executable, created on first run. Never stored in the archive.
data_directory = data
database_name = gateway.sqlite
default_locale = en
; Quiet release notices in the shell and console; uses the applied network/proxy settings.
; Checks stable releases every six hours. No automatic download or restart.
update_check_enabled = true
; auto / always / never; NO_COLOR and RCMAKER_COLOR follow framework banner rules.
banner_color = auto
; Optional external Codex home. Blank uses CODEX_HOME, then the current OS user's home/.codex.
; Windows uses USERPROFILE (or HOMEDRIVE/HOMEPATH); Linux/macOS use HOME or the effective user's home.
codex_home = ""
; Optional CA certificate path for network probes.
probe_ca_file = ""

[app]
default_timezone = UTC
